# Neon (pooled for the app, unpooled for drizzle-kit)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth0 v4 (@auth0/nextjs-auth0)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# Local screenshots / keyboard-only play without Universal Login
# AUTH_STUB=1
# NEXT_PUBLIC_AUTH_STUB=1
